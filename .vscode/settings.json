{
  "python.languageServer": "None",
  "flake8.args": [
    "--config=${workspaceFolder}/.flake8",
    "--max-line-length=999",
    "--extend-ignore=E203,W503,E501"
  ],
  "pycodestyle.args": [
    "--max-line-length=999",
    "--ignore=E501"
  ],
  "python.linting.flake8Args": [
    "--config=${workspaceFolder}/.flake8",
    "--max-line-length=999",
    "--extend-ignore=E203,W503,E501"
  ],
  "python.linting.pycodestyleArgs": [
    "--max-line-length=999",
    "--ignore=E501"
  ],
  "pylint.args": [
    "--rcfile=${workspaceFolder}/pyproject.toml",
    "--max-line-length=999",
    "--max-module-lines=9999",
    "--disable=C0301,C0302"
  ],
  "cSpell.words": [
    "advanced",
    "bcproj",
    "board",
    "boardcomposer",
    "boards",
    "centers",
    "cleared",
    "dock",
    "explorer",
    "exported",
    "qapp"
  ]
}
